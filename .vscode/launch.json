{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Visualize population",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/webviewer/visualize_population.py",
      "console": "integratedTerminal",
      "args": [],
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Python: Visualize individual",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/webviewer/visualize_individual.py",
      "console": "integratedTerminal",
      "args": [],
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Python: Interactive Dashboard",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/webviewer/interactive_dash.py",
      "console": "integratedTerminal",
      "args": ["--port", "8050"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "C++: Debug evo-movement-sim (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Debug/evo-movement-sim",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "preLaunchTask": "CMake: Build (Debug)",
      "miDebuggerPath": "/usr/bin/gdb",
      "windows": {
        "program": "${workspaceFolder}/build/Debug/evo-movement-sim.exe",
        "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe"
      },
      "MIMode": "gdb",
      "externalConsole": false
    },
    {
      "name": "Run Tests (Release)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Release/test_config_output",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "preLaunchTask": "Run CTest (Release)",
      "miDebuggerPath": "/usr/bin/gdb",
      "windows": {
        "program": "${workspaceFolder}/build/Release/test_config_output.exe",
        "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe"
      },
      "MIMode": "gdb",
      "externalConsole": false
    },
    {
      "name": "Rust: Debug evo_movement_rust (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/rust/target/debug/evo_movement_rust",
      "args": ["--config", "rust/prod_run.json"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        { "name": "DISABLE_STEP_PAUSE", "value": "1" },
        { "name": "RAYON_NUM_THREADS", "value": "1" },
        { "name": "OMP_NUM_THREADS", "value": "1" },
        { "name": "NUMEXPR_MAX_THREADS", "value": "1" }
      ],
      "preLaunchTask": "Cargo: build (debug)",
      "miDebuggerPath": "/usr/bin/gdb",
      "windows": {
        "program": "${workspaceFolder}/rust/target/debug/evo_movement_rust.exe",
        "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe"
      },
      "MIMode": "gdb",
      "externalConsole": false
    }
  ]
}